
# --- service ---
# development | test | production (production adds HSTS)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = one JSON object per log line (use in production)
LOG_JSON=false
# Swagger UI at /api/docs
DOCS_ENABLED=true

# --- HTTP edge ---
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# read the client IP from X-Forwarded-For (behind Render/Vercel/a load balancer)
TRUST_PROXY_HEADERS=true
# per client IP, per worker; 0 disables
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120
# browser cache / CDN cache lifetimes for data responses
CACHE_MAX_AGE_SECONDS=300
CACHE_SHARED_MAX_AGE_SECONDS=86400
# rendered-JSON cache per worker; 0 disables
RESPONSE_CACHE_MB=32

# --- data ---
# auto | snapshot | live
DATA_MODE=auto
# SNAPSHOT_PATH=data/snapshot.json.gz
# where a live fetch is saved (point at /tmp on read-only filesystems)
# LIVE_CACHE_PATH=/tmp/snapshot.json.gz
# purchase decisions in scope (delivery days are the day after)
DECISION_DATE_FROM=2026-01-01
DECISION_DATE_TO=2026-01-31
# settled days fetched before the first delivery day (calibration warm-up)
HISTORY_DAYS=30

# --- Elexon Insights API ---
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_ATTEMPTS=5
ELEXON_CONCURRENCY=4
ELEXON_CHUNK_DAYS=7

# --- uvicorn (Docker image) ---
# PORT=8000
# WEB_CONCURRENCY=2

# --- observability (optional) ---
# FastAPI instruments itself with OpenTelemetry. Install the `otel` extra, then:
# FASTAPI_OTEL_AUTO_CONFIGURE=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector:4318
